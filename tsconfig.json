{
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "ES2018",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "lib": [
      "es2018",
      "es2015.proxy",
      "dom",
      "esnext"
    ],
    "paths": {
      "~/*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "lib": [
    "ESNext",
    "ESNext.AsyncIterable",
    "DOM"
  ],
  "esModuleInterop": true,
  "allowJs": true,
  "sourceMap": true,
  "noEmit": true,
  "types": [
    "fast-deep-equal",
    "@types/lodash"
  ],
  "exclude": [
    "node_modules"
  ]
}
