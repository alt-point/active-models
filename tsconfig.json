{
  "compilerOptions": {
    "moduleResolution": "Node",
    "target": "ES2018",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "lib": [
      "es2018",
      "es2015.proxy",
      "dom",
      "esnext",
      "esnext.asynciterable"
    ],
    "types": [
      "node",
      "lodash-es",
      "fast-deep-equal"
    ],
    "paths": {
      "~/*": [
        "./*"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "node_modules"
  ]
}
