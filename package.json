{
  "name": "@alt-point/active-models",
  "version": "4.0.0",
  "description": "Reactive DTO models with Proxy and more useful classes, decorators, Black-jack and hookers",
  "sideEffects": false,
  "bin": {
    "active-models": "./bin/active-models.mjs"
  },
  "keywords": [
    "DTO",
    "active record",
    "reactive",
    "reactive model",
    "proxy",
    "model",
    "helper",
    "data structure"
  ],
  "files": [
    "dist",
    "bin",
    "src",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "exports": {
    "./ActiveModel": {
      "source": "./src/ActiveModel.ts",
      "import": {
        "types": "./dist/ActiveModel.d.mts",
        "default": "./dist/ActiveModel.mjs"
      },
      "require": {
        "types": "./dist/ActiveModel.d.ts",
        "default": "./dist/ActiveModel.js"
      }
    },
    "./decorators": {
      "source": "./src/decorators.ts",
      "import": {
        "types": "./dist/decorators.d.mts",
