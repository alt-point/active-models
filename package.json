{
  "name": "@alt-point/active-models",
  "version": "3.3.0",
  "description": "Reactive DTO models with Proxy and more useful classes, decorators, Black-jack and hookers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": {},
  "sideEffects": false,
  "keywords": [
    "DTO",
    "active record",
    "reactive",
    "reactive model",
    "proxy",
    "model",
    "helper",
    "data structure"
  ],
  "files": [
    "dist/*",
    "src/*",
    "*.js",
    "*.ts"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build-dev": "tsup --watch"
  },
  "homepage": "https://github.com/alt-point/active-models#readme",
  "author": {
    "email": "surrealistik@alt-point.com",
    "name": "SurRealistik",
    "url": "https://alt-point.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-point/active-models"
  },
  "dependencies": {
    "fast-deep-equal": "^3.1.3",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "consola": "^3.2.3",
    "rollup": "^4.16.4",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.4.5"
  }
}
