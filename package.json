{
  "name": "@alt-point/active-models",
  "version": "4.0.0",
  "description": "Reactive DTO models with Proxy and more useful classes, decorators, Black-jack and hookers",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "keywords": [
    "DTO",
    "active record",
    "reactive",
    "reactive model",
    "proxy",
    "model",
    "helper",
    "data structure"
  ],
  "files": [
    "dist",
    "src",
    "AGENTS.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ActiveModel": {
      "source": "./src/ActiveModel.ts",
      "import": {
        "types": "./dist/ActiveModel.d.mts",
        "default": "./dist/ActiveModel.mjs"
      },
      "require": {
        "types": "./dist/ActiveModel.d.ts",
        "default": "./dist/ActiveModel.js"
      }
    },
    "./CallableModel": {
      "source": "./src/CallableModel.ts",
      "import": {
        "types": "./dist/CallableModel.d.mts",
        "default": "./dist/CallableModel.mjs"
      },
      "require": {
        "types": "./dist/CallableModel.d.ts",
        "default": "./dist/CallableModel.js"
      }
    },
    "./decorators": {
      "source": "./src/decorators.ts",
      "import": {
        "types": "./dist/decorators.d.mts",
        "default": "./dist/decorators.mjs"
      },
      "require": {
        "types": "./dist/decorators.d.ts",
        "default": "./dist/decorators.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "build-dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:api": "typedoc",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench": "vitest bench --run --config vitest.perf.config.ts",
    "test:mutation": "stryker run && node scripts/mutation-gate.mjs"
  },
  "homepage": "https://github.com/alt-point/active-models#readme",
  "author": {
    "email": "surrealistik@alt-point.com",
    "name": "SurRealistik",
    "url": "https://alt-point.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-point/active-models"
  },
  "dependencies": {
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "consola": "^3.2.3",
    "eslint": "^10.11.0",
    "mermaid": "^11.16.0",
    "rollup": "^4.16.4",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10"
  }
}
