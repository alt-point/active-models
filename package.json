  "scripts": {
    "build": "tsup",
    "build-dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "typedoc && vitepress dev docs",
    "docs:build": "typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docs:api": "typedoc",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench": "vitest bench --run --config vitest.perf.config.ts",
    "test:mutation": "stryker run && node scripts/mutation-gate.mjs",
    "test:dist": "node scripts/smoke-dist.mjs"
  },
  "homepage": "https://github.com/alt-point/active-models#readme",
  "author": {
    "email": "surrealistik@alt-point.com",
    "name": "SurRealistik",
    "url": "https://alt-point.com/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alt-point/active-models"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "consola": "^3.2.3",
    "esbuild": "^0.27.7",
    "eslint": "^10.11.0",
    "lodash-es": "^4.17.21",
    "mermaid": "^11.16.0",
    "rollup": "^4.16.4",
    "tslib": "^2.6.2",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10"
  },
  "typesVersions": {
    "*": {
      "ActiveModel": [
        "dist/ActiveModel.d.ts"
      ],
      "decorators": [
        "dist/decorators.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "ActiveCollection": [
        "dist/ActiveCollection.d.ts"
      ],
      "ActiveMap": [
        "dist/ActiveMap.d.ts"
      ],
      "ActiveSet": [
        "dist/ActiveSet.d.ts"
      ],
      "collectionRegistry": [
        "dist/collectionRegistry.d.ts"
      ],
      "pipeline": [
        "dist/pipeline.d.ts"
      ],
      "CallableModel": [
        "dist/CallableModel.d.ts"
      ],
      "Enum": [
        "dist/Enum.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "scalars/Decimal": [
        "dist/scalars/Decimal.d.ts"
      ],
      "scalars/Money": [
        "dist/scalars/Money.d.ts"
      ],
      "scalars/LocalDate": [
        "dist/scalars/LocalDate.d.ts"
      ],
      "scalars/immutable": [
        "dist/scalars/immutable.d.ts"
      ]
    }
  }
}
